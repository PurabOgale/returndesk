# PostgreSQL connection string (local Postgres, Docker, Neon, or Supabase)
# Example local: postgresql://postgres:postgres@localhost:5432/returndesk
# Example Neon/Supabase: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/returndesk"

# Optional: set to "true" if connecting to a managed Postgres that requires SSL without cert verification
DATABASE_SSL="false"
